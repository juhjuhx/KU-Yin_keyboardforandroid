# Build outputs
build/
app/build/
app/.cxx/
*.apk
*.apkm
*.aar

# Gradle
.gradle/

# Android Studio
.idea/
*.iml
*.iws
*.ipr
.androidstudio/

# Native libraries (pre-built binaries)
app/src/main/jniLibs/
!app/src/main/jniLibs/.gitkeep

# Pinned native deps and downloaded dictionaries (regenerated via scripts/bootstrap_native_deps.sh)
app/src/main/cpp/.deps/
app/src/main/assets/

# macOS metadata
.DS_Store
app/.DS_Store

# Local config (contains SDK paths)
local.properties
!local.properties.example

# JDK / NDK downloads
jdk-*/
android-ndk-*/
android-licenses/

# Python scripts
__pycache__/
*.pyc
*.pyo
manual_install_sdk.py

# Installation scripts (Windows batch files for SDK setup)
install-sdk*.bat
install-sdk*.ps1
setup-sdk*.bat
setup-sdk*.ps1
final-install-sdk.bat
run-sdk-setup.bat
build-libchewing-build-apk.ps1

# libchewing source (884MB, too large for git)
app/src/main/cpp/libchewing-src/
!app/src/main/cpp/libchewing-src/.gitkeep

# Temporary
*.tmp
*.temp
*.log

.worktrees/

# Local review artifacts (OCR JSON, workspace inventories - never commit raw dumps)
review-artifacts/
