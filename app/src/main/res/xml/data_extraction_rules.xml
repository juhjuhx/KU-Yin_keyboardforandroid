<?xml version="1.0" encoding="utf-8"?>
<!-- Owner-approved F3 policy: D2D preferences only; no feedback or learning transfer.
     Android/OEM behavior still requires device acceptance. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- An include makes this mode an allowlist. Never add a broad root include. -->
        <include domain="sharedpref" path="kuyin_settings.xml" />
    </device-transfer>
</data-extraction-rules>
